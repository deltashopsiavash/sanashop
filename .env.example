DOMAIN=shop.example.com
ACME_EMAIL=owner@example.com
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=shop.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://shop.example.com
POSTGRES_DB=sanashop
POSTGRES_USER=sanashop
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://sanashop:change-me@db:5432/sanashop
SANASHOP_BOT_API_KEY=change-me-with-openssl-rand-hex-32
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0
DEFAULT_SITE_NAME=سنا
DEFAULT_CARD_NUMBER=
DEFAULT_CARD_OWNER=
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=owner@example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_USE_TLS=1
DEFAULT_FROM_EMAIL=SanaShop <support@mail.shop.example.com>

# Optional Docker image overrides: useful if one registry mirror is unavailable.
# The defaults come from docker.novin.cloud so fresh Iranian hosts do not need auth.docker.io.
SANASHOP_PYTHON_IMAGE=docker.novin.cloud/library/python:3.12-slim
SANASHOP_POSTGRES_IMAGE=docker.novin.cloud/library/postgres:16-alpine
SANASHOP_CADDY_IMAGE=docker.novin.cloud/library/caddy:2.10-alpine
