{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  # The management API is authenticated by a strong per-site Bearer key in Django.
  # Do not bind it to a single source IP: existing installs and external bot servers
  # may change IP, and an IP-only Caddy gate can silently break otherwise-valid bots.

  handle_path /static/* {
    root * /srv/static
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle /media/receipts/* {
    respond "Not found" 404
  }

  handle_path /media/* {
    root * /srv/media
    # Product/logo/category/story media is mutable. Never keep an old upload for days.
    # New replacements also receive unique URLs, while this header makes old browser
    # caches revalidate immediately if a legacy URL is encountered.
    header Cache-Control "public, max-age=0, must-revalidate"
    header Pragma "no-cache"
    file_server
  }

  reverse_proxy web:8000
}
